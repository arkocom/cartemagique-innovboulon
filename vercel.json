{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "corepack pnpm check && corepack pnpm test && corepack pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/editor",
      "destination": "/index.html"
    },
    {
      "source": "/editor/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
